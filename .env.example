PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_USERNAME=pdladmin
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-14-characters
# Email notifications for form submissions (SMTP)
NOTIFY_EMAIL=info@pdl-logistics.com.sg
MAIL_FROM=info@pdl-logistics.com.sg
SMTP_HOST=smtp.your-mail-host.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@pdl-logistics.com.sg
SMTP_PASS=replace-with-email-account-password
# Optional: use a bcrypt hash instead of ADMIN_PASSWORD after generating one.
# ADMIN_PASSWORD_HASH=$2a$12$...
